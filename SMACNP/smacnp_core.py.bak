#!/usr/bin/env python3
"""Localized SMACNP core, adapted for per-variable models.

Based on Dumitrescu 2026 (climate-gridder). Localized encoder only.
Supports regular Gaussian and two-step (occurrence + amount) heads.
"""

from __future__ import annotations

import math
from typing import Dict, Optional, Tuple

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F

try:
    from torch_cluster import knn
except ImportError:
    knn = None


def _create_mlp(
    input_dim: int,
    output_dim: int,
    hidden_size: int,
    num_hidden_layers: int,
    dropout_rate: float,
    final_activation: Optional[nn.Module] = None,
) -> nn.Sequential:
    layers = []
    prev = input_dim
    for _ in range(num_hidden_layers):
        layers.append(nn.Linear(prev, hidden_size))
        layers.append(nn.ReLU())
        if dropout_rate > 0:
            layers.append(nn.Dropout(dropout_rate))
        prev = hidden_size
    layers.append(nn.Linear(prev, output_dim))
    if final_activation is not None:
        layers.append(final_activation)
    return nn.Sequential(*layers)


class SpatialPositionalEncoding(nn.Module):
    def __init__(self, spatial_dim: int = 2, encoding_dim: int = 32, pe_type: str = "sinusoidal"):
        super().__init__()
        self.spatial_dim = spatial_dim
        self.encoding_dim = encoding_dim
        self.pe_type = pe_type
        if pe_type == "sinusoidal":
            self.freqs = nn.Parameter(torch.randn(encoding_dim // 2) * 0.1, requires_grad=False)

    def forward(self, coords: torch.Tensor) -> torch.Tensor:
        # coords: (..., 2) assumed normalized roughly to [-1, 1] or [0, 1]
        if self.pe_type != "sinusoidal":
            return coords
        # Simple sinusoidal PE
        half = self.encoding_dim // 2
        freqs = self.freqs[:half].to(coords.device)
        x = coords[..., 0:1] * freqs
        y = coords[..., 1:2] * freqs
        pe = torch.cat([torch.sin(x), torch.cos(x), torch.sin(y), torch.cos(y)], dim=-1)
        if pe.shape[-1] > self.encoding_dim:
            pe = pe[..., : self.encoding_dim]
        elif pe.shape[-1] < self.encoding_dim:
            pe = F.pad(pe, (0, self.encoding_dim - pe.shape[-1]))
        return pe


class LaplaceAttention(nn.Module):
    def __init__(self, p_norm: float = 1.0, init_temp: float = 1.0):
        super().__init__()
        self.p_norm = p_norm
        self.log_temp = nn.Parameter(torch.tensor(math.log(init_temp)))

    def forward(self, query: torch.Tensor, key: torch.Tensor, value: torch.Tensor) -> torch.Tensor:
        # query: (B, M, D), key: (B, N, D), value: (B, N, V)
        temp = torch.exp(self.log_temp).clamp(min=1e-3, max=10.0)
        dist = torch.cdist(query, key, p=self.p_norm)
        attn = torch.softmax(-dist / temp, dim=-1)
        return torch.bmm(attn, value)


class MeanLocationEncoder(nn.Module):
    def __init__(self, spatial_dim: int, y_dim: int, hidden_size: int, w_dim: int, dropout: float, num_layers: int = 1, p_norm: float = 1.0):
        super().__init__()
        self.mlp = _create_mlp(spatial_dim + y_dim, w_dim, hidden_size, num_layers, dropout)
        self.attn = LaplaceAttention(p_norm=p_norm)

    def forward(self, s_context: torch.Tensor, y_context: torch.Tensor, s_target: torch.Tensor) -> torch.Tensor:
        ctx = torch.cat([s_context, y_context], dim=-1)
        w_ctx = self.mlp(ctx)
        # query is target spatial only (no y)
        q = s_target
        # key is context spatial
        k = s_context
        return self.attn(q, k, w_ctx)


class MultiHeadCrossAttention(nn.Module):
    def __init__(self, embed_dim: int, num_heads: int, dropout: float = 0.1):
        super().__init__()
        self.mha = nn.MultiheadAttention(embed_dim, num_heads, dropout=dropout, batch_first=True)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, query: torch.Tensor, key: torch.Tensor, value: torch.Tensor) -> torch.Tensor:
        out, _ = self.mha(query, key, value)
        return self.norm(out + query)


class LocalizedMeanAttributeEncoder(nn.Module):
    def __init__(
        self,
        input_dim: int,
        y_dim: int,
        hidden_size: int,
        r_dim: int,
        num_heads: int,
        dropout: float,
        k: int,
        num_layers: int = 1,
        use_pe: bool = True,
        pe_dim: int = 32,
    ):
        super().__init__()
        self.k = k
        self.use_pe = use_pe
        self.pe = SpatialPositionalEncoding(2, pe_dim) if use_pe else None
        pe_extra = pe_dim if use_pe else 0
        self.embed = _create_mlp(input_dim + pe_extra + y_dim, r_dim, hidden_size, num_layers, dropout)
        self.attn = MultiHeadCrossAttention(r_dim, num_heads, dropout)

    def forward(
        self,
        x_context: torch.Tensor,
        y_context: torch.Tensor,
        x_target: torch.Tensor,
        s_context: torch.Tensor,
        s_target: torch.Tensor,
    ) -> torch.Tensor:
        # Localized: for each target, attend only to k nearest context points
        if knn is None:
            raise RuntimeError("torch_cluster.knn required for Localized encoder")
        # knn expects (N, D) flattened; we assume batch dim = 1 for simplicity in this port
        # For full batched support the original uses more careful indexing; here we handle B=1 first
        B, N, _ = s_context.shape
        M = s_target.shape[1]
        # Flatten for knn
        s_ctx_flat = s_context.reshape(-1, 2)
        s_tgt_flat = s_target.reshape(-1, 2)
        # knn returns (2, B*M*k) edge_index style
        edge_index = knn(s_ctx_flat, s_tgt_flat, k=min(self.k, N), batch_x=None, batch_y=None)
        # For simplicity in this initial port we fall back to full attention when batching is complex;
        # production version will use the original's careful k-NN masking.
        # TODO: replace with proper batched k-NN masking from climate-gridder
        pe_ctx = self.pe(s_context) if self.use_pe else torch.zeros_like(s_context[..., :1])
        pe_tgt = self.pe(s_target) if self.use_pe else torch.zeros_like(s_target[..., :1])
        ctx_in = torch.cat([x_context, pe_ctx, y_context], dim=-1) if self.use_pe else torch.cat([x_context, y_context], dim=-1)
        tgt_in = torch.cat([x_target, pe_tgt], dim=-1) if self.use_pe else x_target
        r_ctx = self.embed(ctx_in)
        r_tgt = self.embed(torch.cat([tgt_in, torch.zeros_like(y_context[:, :1, :])], dim=-1))  # dummy y for target
        return self.attn(r_tgt, r_ctx, r_ctx)


class LocalizedVarianceEncoder(nn.Module):
    def __init__(
        self,
        input_dim: int,
        hidden_size: int,
        v_dim: int,
        num_heads: int,
        dropout: float,
        k: int,
        num_layers: int = 1,
        use_pe: bool = True,
        pe_dim: int = 32,
    ):
        super().__init__()
        self.k = k
        self.use_pe = use_pe
        self.pe = SpatialPositionalEncoding(2, pe_dim) if use_pe else None
        pe_extra = pe_dim if use_pe else 0
        self.embed = _create_mlp(input_dim + pe_extra, v_dim, hidden_size, num_layers, dropout)
        self.attn = MultiHeadCrossAttention(v_dim, num_heads, dropout)

    def forward(self, x_context: torch.Tensor, x_target: torch.Tensor, s_context: torch.Tensor, s_target: torch.Tensor) -> torch.Tensor:
        pe_ctx = self.pe(s_context) if self.use_pe else torch.zeros_like(s_context[..., :1])
        pe_tgt = self.pe(s_target) if self.use_pe else torch.zeros_like(s_target[..., :1])
        ctx_in = torch.cat([x_context, pe_ctx], dim=-1) if self.use_pe else x_context
        tgt_in = torch.cat([x_target, pe_tgt], dim=-1) if self.use_pe else x_target
        v_ctx = self.embed(ctx_in)
        v_tgt = self.embed(tgt_in)
        return self.attn(v_tgt, v_ctx, v_ctx)


class MeanDecoder(nn.Module):
    def __init__(self, r_dim: int, w_dim: int, spatial_dim: int, attr_dim: int, hidden_size: int, out_dim: int, dropout: float, num_layers: int = 1):
        super().__init__()
        self.mlp = _create_mlp(r_dim + w_dim + spatial_dim + attr_dim, out_dim, hidden_size, num_layers, dropout)

    def forward(self, r_star: torch.Tensor, w_star: torch.Tensor, s_target: torch.Tensor, x_attr_target: torch.Tensor) -> torch.Tensor:
        return self.mlp(torch.cat([r_star, w_star, s_target, x_attr_target], dim=-1))


class VarianceDecoder(nn.Module):
    def __init__(self, v_dim: int, spatial_dim: int, attr_dim: int, hidden_size: int, out_dim: int, dropout: float, num_layers: int = 1):
        super().__init__()
        self.mlp = _create_mlp(v_dim + spatial_dim + attr_dim, out_dim, hidden_size, num_layers, dropout, final_activation=nn.Softplus())

    def forward(self, v_star: torch.Tensor, s_target: torch.Tensor, x_attr_target: torch.Tensor) -> torch.Tensor:
        return self.mlp(torch.cat([v_star, s_target, x_attr_target], dim=-1))


class SMACNP(nn.Module):
    """Per-variable Localized SMACNP.

    For regular variables: outputs mu, variance.
    For two-step (precip/snow): outputs occurrence_logits, amount_mu, amount_variance.
    """

    def __init__(
        self,
        input_dim: int,
        spatial_dim: int = 2,
        attr_dim: int = 3,
        y_dim: int = 1,
        two_step: bool = False,
        r_dim: int = 64,
        w_dim: int = 256,
        v_dim: int = 512,
        hidden_size: int = 512,
        num_layers_mlp: int = 3,
        num_heads: int = 8,
        dropout_rate: float = 0.1,
        laplace_distance_p: float = 1.0,
        k_localized: int = 15,
        use_positional_encoding: bool = True,
        pe_dim: int = 32,
        variance_floor: float = 2e-4,
    ):
        super().__init__()
        self.two_step = two_step
        self.variance_floor = variance_floor
        self.spatial_dim = spatial_dim
        self.attr_dim = attr_dim

        self.mean_loc = MeanLocationEncoder(spatial_dim, y_dim, hidden_size, w_dim, dropout_rate, num_layers_mlp, laplace_distance_p)
        self.mean_attr = LocalizedMeanAttributeEncoder(
            input_dim, y_dim, hidden_size, r_dim, num_heads, dropout_rate, k_localized, num_layers_mlp, use_positional_encoding, pe_dim
        )
        self.var_enc = LocalizedVarianceEncoder(
            input_dim, hidden_size, v_dim, num_heads, dropout_rate, k_localized, num_layers_mlp, use_positional_encoding, pe_dim
        )

        out_mu = 1
        self.mean_dec = MeanDecoder(r_dim, w_dim, spatial_dim, attr_dim, hidden_size, out_mu, dropout_rate, num_layers_mlp)
        self.var_dec = VarianceDecoder(v_dim, spatial_dim, attr_dim, hidden_size, out_mu, dropout_rate, num_layers_mlp)

        if two_step:
            self.occ_dec = MeanDecoder(r_dim, w_dim, spatial_dim, attr_dim, hidden_size, 1, dropout_rate, num_layers_mlp)
            self.amount_mean_dec = MeanDecoder(r_dim, w_dim, spatial_dim, attr_dim, hidden_size, 1, dropout_rate, num_layers_mlp)
            self.amount_var_dec = VarianceDecoder(v_dim, spatial_dim, attr_dim, hidden_size, 1, dropout_rate, num_layers_mlp)

    def forward(self, x_context_all: torch.Tensor, y_context: torch.Tensor, x_target_all: torch.Tensor) -> Dict[str, torch.Tensor]:
        # Split spatial / attributes (first 2 dims are x,y)
        s_ctx = x_context_all[..., : self.spatial_dim]
        x_attr_ctx = x_context_all[..., self.spatial_dim :]
        s_tgt = x_target_all[..., : self.spatial_dim]
        x_attr_tgt = x_target_all[..., self.spatial_dim :]

        w_star = self.mean_loc(s_ctx, y_context, s_tgt)
        r_star = self.mean_attr(x_attr_ctx, y_context, x_attr_tgt, s_ctx, s_tgt)
        v_star = self.var_enc(x_attr_ctx, x_attr_tgt, s_ctx, s_tgt)

        if self.two_step:
            return {
                "occurrence_logits": self.occ_dec(r_star, w_star, s_tgt, x_attr_tgt),
                "amount_mu": self.amount_mean_dec(r_star, w_star, s_tgt, x_attr_tgt),
                "amount_variance": self.amount_var_dec(v_star, s_tgt, x_attr_tgt).clamp(min=self.variance_floor),
            }
        else:
            return {
                "mu": self.mean_dec(r_star, w_star, s_tgt, x_attr_tgt),
                "variance": self.var_dec(v_star, s_tgt, x_attr_tgt).clamp(min=self.variance_floor),
            }


def gaussian_nll(mu: torch.Tensor, var: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
    var = var.clamp(min=1e-4)
    return 0.5 * (torch.log(2 * math.pi * var) + (target - mu) ** 2 / var).mean()


def two_step_loss(pred: Dict[str, torch.Tensor], y: torch.Tensor, pos_weight_cap: float = 20.0) -> torch.Tensor:
    """y is the (possibly log-normalized) amount. Occurrence is (y > 0)."""
    is_pos = (y > 1e-6).float()
    num_pos = is_pos.sum().clamp(min=1)
    num_neg = is_pos.numel() - num_pos
    pos_weight = (num_neg / num_pos).clamp(max=pos_weight_cap)
    bce = F.binary_cross_entropy_with_logits(pred["occurrence_logits"], is_pos, pos_weight=pos_weight)
    mask = is_pos.bool()
    if mask.any():
        nll = gaussian_nll(pred["amount_mu"][mask], pred["amount_variance"][mask], y[mask])
    else:
        nll = torch.tensor(0.0, device=y.device)
    return bce + nll
